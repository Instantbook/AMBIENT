<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.instantbook.ambient"
    android:versionCode="1"
    android:versionName="1.0">

  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <!-- Settings live in a plain JSON file on the microSD so they survive a
       pm clear and can be edited from a computer over MTP. Scoped storage
       blocks arbitrary paths without this; grant it with
         adb shell appops set io.github.instantbook.ambient              MANAGE_EXTERNAL_STORAGE allow
       Without it the app falls back to its own external directory, which
       works but is wiped with the app. -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
  <!-- MUSIC reads the library through MediaStore, which is the only way to
       see a removable card: direct file access to /storage/<uuid> is denied
       to an ordinary app even with All-files granted. Grant with
         adb shell pm grant io.github.instantbook.ambient \
             android.permission.READ_EXTERNAL_STORAGE -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
      android:maxSdkVersion="32"/>
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
  <!-- WI-FI card. The network NAME needs location on Android 10+, and is
       only cosmetic - without the grant the card still works, it just
       says "Wi-Fi" instead of "WestJet Wi-Fi". Grant with
         adb shell pm grant io.github.instantbook.ambient \
             android.permission.ACCESS_FINE_LOCATION -->
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

  <!-- A Google TV box has neither, and requiring them would hide the app -->
  <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
  <uses-feature android:name="android.software.leanback" android:required="false"/>

  <application
      android:label="AMBIENT"
      android:icon="@mipmap/ic_launcher"
      android:banner="@drawable/banner"
      android:usesCleartextTraffic="true"
      android:supportsRtl="false">
    <!-- usesCleartextTraffic: targeting API 28+ blocks plain http in both
         HttpURLConnection and the WebView by default, and a captive portal
         is found and entered over plain http by definition - the sign-in
         page exists because https cannot be intercepted. -->
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:label="AMBIENT"
        android:launchMode="singleTask"
        android:screenOrientation="landscape"
        android:configChanges="orientation|screenSize|keyboardHidden|navigation"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <!-- LEANBACK_LAUNCHER puts it on the Google TV home row -->
        <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <!-- Offer AMBIENT as the Wi-Fi sign-in app. The system's own one is a
           touch-only WebView; this one has d-pad link navigation and the
           air-mouse cursor. Android asks which to use the first time. -->
      <intent-filter>
        <action android:name="android.net.conn.CAPTIVE_PORTAL"/>
        <category android:name="android.intent.category.DEFAULT"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
